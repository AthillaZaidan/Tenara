# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://tenara:tenara@localhost:5432/tenara
TEST_DATABASE_URL=postgresql+psycopg://tenara:tenara@localhost:5432/tenara_test

# Required (non-default) when APP_ENV is not "development".
# In development leave these two commented out; empty values would override the safe defaults.
# JWT_SECRET=
# FILE_URL_SECRET=
STORAGE_DIR=./storage

# Used only by: uv run python -m scripts.seed_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# VLM / LLM provider (see experiments/vlm_eval/.env.example)
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna

# Web app (web/ loads this root file through @next/env). Public: called from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
