# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://tenara:tenara@localhost:5432/tenara
TEST_DATABASE_URL=postgresql+psycopg://tenara:tenara@localhost:5432/tenara_test

# Required (non-default) when APP_ENV is not "development".
# In development leave these two commented out; empty values would override the safe defaults.
# JWT_SECRET=
# FILE_URL_SECRET=
STORAGE_DIR=./storage

# Used only by: uv run python -m scripts.seed_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# VLM / LLM provider (see experiments/vlm_eval/.env.example)
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna
# Design prompt interpreter: llm (LLM_MODEL, falls back to rules on failure) or rules (offline)
PROMPT_INTERPRETER=llm
# Fabric scan photo description only; leave empty to use LLM_MODEL
LLM_VISION_MODEL=google/gemma-4-26b-a4b-it
# Photo Fit On drawn by an image model. The buyer opts in per request because the photo leaves the server;
# one image costs about $0.04 with google/gemini-nano-banana-2.1. Empty = only the local overlay.
LLM_IMAGE_MODEL=

# Web app (web/ loads this root file through @next/env). Public: called from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
