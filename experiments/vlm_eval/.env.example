# Copy to .env (same folder or project root) and fill in. Never commit .env.
# Pick ONE provider: openai | openrouter | ollama
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# openrouter example: openai/gpt-6-luna   |  openai example: gpt-6-luna   |  ollama example: qwen3-vl:8b
LLM_MODEL=openai/gpt-6-luna
